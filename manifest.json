{
  "manifest_version": 3,
  "name": "Square to Doc",
  "version": "1.0.0",
  "description": "Crawl questions and answers from Square Base and save them to Google Docs.",
  "permissions": [
    "identity",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://changelogs.base.vn/*",
    "https://square.base.vn/*",
    "https://docs.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://changelogs.base.vn/changelogs*",
        "https://square.base.vn/stack/*"
      ],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "oauth2": {
    "client_id": "802015831673-eqg6ll2mkbeo7asv9830sa4j2rc89eo5.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/documents"
    ]
  }
} 